# Exemplo de variáveis de ambiente para desenvolvimento local.
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite .env no repositório.

# Banco de dados
PAYMENT_DB_URI=jdbc:mysql://localhost:3306/vintipay?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
PAYMENT_DB_USERNAME=root
PAYMENT_DB_PASSWORD=root

# JWT
JWT_PUBLIC_KEY=classpath:app.pub
JWT_PRIVATE_KEY=classpath:app.key

# APIs externas
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3
BREVO_EMAIL_FROM=no-reply@vintipay.cv

STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

VENDUS_API_KEY=
VENDUS_API_URL=https://www.vendus.cv/ws/v1.2

# Keycloak
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8080
KEYCLOAK_FRONTEND_URL=http://localhost:18080
KEYCLOAK_REALM=vintipay
KEYCLOAK_RESOURCE=vintipay-client
KEYCLOAK_CREDENTIALS_SECRET=
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=

# Aplicação
APP_BASE_URL=https://localhost:8443
APP_ENCRYPTION_SECRET=

# Kafka
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9093
SPRING_KAFKA_CONSUMER_GROUP_ID=vintipay-webhook-group
SPRING_KAFKA_CONSUMER_AUTO_OFFSET_RESET=earliest

# SISP
SISP_URL_3D=https://mc.vinti4net.cv/3ds_middleware_php/public/3ds_init.php
SISP_URL_NORMAL=https://mc.vinti4net.cv/BizMPIOnUsSisp/CardPayment
SISP_DEV_URL_3D=https://localhost:8443/simulador/sisp/3ds_middleware_php/public/3ds_init.php
SISP_DEV_URL_NORMAL=https://localhost:3001/simulador/sisp/3ds_middleware_php/public/3ds_init.php
SISP_QLD_URL_3D=https://mc.vinti4net.cv/3ds_middleware_php/public/3ds_init.php
SISP_QLD_URL_NORMAL=https://mc.vinti4net.cv/BizMPIOnUsSisp/CardPayment
SISP_CHECKOUT_RETURN_URL=https://localhost:8443/webhook/sisp/pagamentos/retorno
