# Exemplo de variáveis de ambiente para o Docker Compose.
# Copie este arquivo para .env.docker e preencha os valores reais.
# NUNCA commite .env.docker no repositório.

# MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=vintipay
MYSQL_USER=vintipay
MYSQL_PASSWORD=vintipay

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Aplicação
VINTIPAY_AUTO_IMPORT_ENABLED=true
SERVER_PORT=8443
SERVER_SSL_ENABLED=false
JWT_PUBLIC_KEY=classpath:app.pub
JWT_PRIVATE_KEY=classpath:app.key
APP_BASE_URL=http://localhost:18443

# APIs externas
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3
BREVO_EMAIL_FROM=no-reply@vintipay.cv

STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

VENDUS_API_URL=api.vendus.pt/1.1
VENDUS_API_KEY=

# Keycloak
KEYCLOAK_AUTH_SERVER_URL=http://vintipay-keycloak:8080
KEYCLOAK_FRONTEND_URL=http://localhost:18080
KEYCLOAK_REALM=vintipay
KEYCLOAK_RESOURCE=vintipay-client
KEYCLOAK_CREDENTIALS_SECRET=
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=

# Kafka
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
SPRING_KAFKA_CONSUMER_GROUP_ID=vintipay-webhook-group
SPRING_KAFKA_CONSUMER_AUTO_OFFSET_RESET=earliest

# SISP
SISP_URL_3D=https://mc.vinti4net.cv/3ds_middleware_php/public/3ds_init.php
SISP_URL_NORMAL=https://mc.vinti4net.cv/BizMPIOnUsSisp/CardPayment
SISP_DEV_URL_3D=https://localhost:18443/simulador/sisp/3ds_middleware_php/public/3ds_init.php
SISP_DEV_URL_NORMAL=https://localhost:3001/simulador/sisp/3ds_middleware_php/public/3ds_init.php
SISP_QLD_URL_3D=https://mc.vinti4net.cv/3ds_middleware_php/public/3ds_init.php
SISP_QLD_URL_NORMAL=https://mc.vinti4net.cv/BizMPIOnUsSisp/CardPayment
SISP_CHECKOUT_RETURN_URL=http://localhost:18443/webhook/sisp/pagamentos/retorno
